{
  "name": "git-motion",
  "version": "0.1.0",
  "description": "Cinematic architecture walkthroughs and module reels generated directly from your codebase and git history.",
  "type": "module",
  "bin": {
    "git-motion": "./dist/cli/bin.js"
  },
  "scripts": {
    "dev": "vite",
    "build:studio": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "pnpm build:studio && pnpm build:server",
    "studio": "vite",
    "cli": "tsx src/cli/bin.ts",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "git",
    "remotion",
    "video",
    "architecture",
    "codebase-visualization",
    "ast",
    "developer-tools"
  ],
  "author": "harileexyz",
  "license": "MIT",
  "dependencies": {
    "@remotion/bundler": "4.0.534",
    "@remotion/cli": "4.0.534",
    "@remotion/player": "4.0.534",
    "commander": "^12.1.0",
    "cors": "^2.8.5",
    "d3-force": "^3.0.0",
    "express": "^4.21.2",
    "lucide-react": "^0.475.0",
    "mermaid": "^12.2.0",
    "open": "^10.1.0",
    "picocolors": "^1.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.534"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/d3-force": "^3.0.10",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
